# VOID//CTF environment configuration
#
# Do not edit secrets here. Run `voidctf init` (Windows: .\voidctf.cmd init) to
# create .env from this template with freshly generated random secrets.
# .env is git-ignored and must never be committed.

# --- CTFd -------------------------------------------------------------------
# Official CTFd image tag. The VOID theme is built against 3.8.x.
CTFD_VERSION=3.8.9

# Flask session/signing secret. 64 hex chars; generated by `voidctf init`.
SECRET_KEY=change-me

# Gunicorn workers. Keep 1 for a small local event; raise for 100+ players.
CTFD_WORKERS=1

# --- Network ----------------------------------------------------------------
# 127.0.0.1 keeps the platform private to this computer (recommended).
# Use 0.0.0.0 only if you deliberately want other machines on your LAN to connect.
BIND_ADDRESS=127.0.0.1
CTFD_PORT=8000

# --- Database (MariaDB) -----------------------------------------------------
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# --- Training target for the "Staff Only" starter challenge ------------------
# Only started with `voidctf training-up`. Always bound to 127.0.0.1.
TRAINING_WEB_PORT=8081
TRAINING_WEB_FLAG=flag{example_trust_no_cookie}
